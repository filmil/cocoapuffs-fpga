# Trust the embedded (dtc-produced) device tree so libfdt skips its per-call
# header re-validation -- ~3-4x fewer instructions through OpenSBI's heavy FDT
# walking, which is what makes the NOEL-V RTL sim tractable. Identical behavior
# for a valid DTB. See third_party/opensbi/fdt_assume_perfect.patch.
single_version_override(
    module_name = "opensbi",
    version = "1.6",
    patch_strip = 1,
    patches = [
        "//third_party/opensbi:fdt_assume_perfect.patch",
        # DEBUG/sim: skip 4 early-init FDT driver scans that find nothing on our
        # board, so the NOEL-V RTL sim reaches the post-early-init hang faster.
        "//third_party/opensbi:skip_unused_early_scans.patch",
        # DEBUG/HW: gaisler APBUART putc uses the drained method (poll TS) instead
        # of FIFO-burst, which garbles ~4x on the board -- so OpenSBI's console
        # diagnostics are readable on hardware.
        "//third_party/opensbi:gaisler_drained_putc.patch",
        # DEBUG/HW: raw bit-bang tracer for each init_coldboot step (tag + rc),
        # to find which step fails on hardware and its error code.
        "//third_party/opensbi:coldboot_tracer.patch",
        # DEBUG/HW: pinpoint the sbi_domain_init EINVAL (context_init rc /
        # domain_finalized / sanitize rc).
        "//third_party/opensbi:domain_tracer.patch",
        # HW WORKAROUND: emulate atomic_cmpxchg without LR/SC. This NOEL-V does
        # not hold lr.d/sc.d reservations on the DDR3/bridge path (proven: works
        # in sim against ahb_bram, fails 0/1000 on HW), so the firmware's only
        # lr/sc spins forever at the S-mode handoff. Single-hart -> safe.
        "//third_party/opensbi:single_hart_cmpxchg.patch",
        # HW: register the APBUART as an M-accessible MMIO region so M-mode
        # keeps UART access after PMP config (trap dumps + S-mode SBI console).
        "//third_party/opensbi:uart_m_region.patch",
        # HW (Smrnmi): mask mie before the S-mode handoff so no M-interrupt
        # fires on kernel entry once fw_base.S sets mnstatus.NMIE=1 (else the
        # hart wedges at the payload entry with no output).
        "//third_party/opensbi:quiesce_mie_handoff.patch",
    ],
)

