package(default_visibility = ["//visibility:public"])

# Initialize all registers at reset (grlib_sync_reset_enable_all = 1) so the core
# comes up with defined state in simulation instead of X.  HP (ASIC) uses minimal
# reset to save area, leaving most regs X in sim; the FPGA flow enables full sync
# reset.  Swapped into grlib_sim in place of the stock config_vhd_file.
genrule(
    name = "config_simreset",
    srcs = ["@grlib//third_party/grlib:config_vhd_file"],
    outs = ["config_simreset.vhd"],
    cmd = "sed 's/4 => 0, -- grlib_sync_reset_enable_all/4 => 1, -- grlib_sync_reset_enable_all/' $(SRCS) > $@",
)

# Relax the boot-time "X in data going to cache" guard (iunv.vhd) -- the uninit
# regfile makes an early speculative store carry X operands; the store is squashed,
# so demote the assertion failure -> note so the sim runs and we can observe the
# real (defined) stores.  Sim-only; no effect on synthesis.
# ALSO: rename the `vmode` identifier (trigger_textra_match, grlib 2025.2-b4298)
# to vmode_in -- Vivado's VHDL parser treats `vmode` as a reserved word and
# errors "syntax error near 'vmode'" (xvhdl + synth alike).  Rename is safe:
# `vmode` appears ONLY in iunv.vhd in all of grlib.
# ALSO: initialize the register record to RRES (`signal r, rin : registers :=
# RRES`).  In RTL sim r.csr.pmp_precalc powers up U and the sync reset never
# cleanses it (proven by the smode_csr_xdump record dump, 2026-07-04): with
# precalc.valid=U NO PMP entry matches, and RISC-V denies S/U accesses without
# a match -> every S-mode ifetch faults (mcause=1) while M-mode runs -> the
# OpenSBI->shim handoff trap-loops in sim only.  On HW the GSR initializes the
# FFs (and synthesis maps initializers to FF INIT = the reset value), so this
# is hardware-faithful.
# ALSO: recompute csr_mmu.precalc combinationally from the ARCHITECTURAL
# pmpaddr/pmpcfg registers instead of forwarding r.csr.pmp_precalc.  Even with
# the RRES init, the first post-reset cycles write U into precalc entries 0-3
# (an early-pipeline speculative CSR-write seeded by the uninitialized BTB;
# time-series-proven: rin.csr.pmp_precalc is U at 106 ns from a defined r) and
# the clean bulk recompute never lands afterwards.  The precalc register is by
# design just a pipelined copy of pmp_precalc(pmpaddr, pmpcfg), so sourcing the
# MMU/cctrl copy from the (defined) architectural registers is HW-equivalent
# and immune to the sim-X, whatever writes the register copy.  Sim-only build.
genrule(
    name = "iunv_relaxed",
    srcs = ["@@grlib++http_archive+grlib_srcs//:lib/gaisler/noelv/core/iunv.vhd"],
    outs = ["iunv_relaxed.vhd"],
    cmd = "sed -e '/X in data going to cache/s/severity failure/severity note/' " +
          "-e 's/\\bvmode\\b/vmode_in/g' " +
          "-e 's/signal r, rin         : registers;/signal r, rin : registers := RRES;/' " +
          # X-robust pmpaddr write gate: the pmpcfg L bit reads U in the early-
          # poisoned entries, and `U = '0'` is false -> csrw pmpaddr silently
          # DROPPED (OpenSBI programs addr-then-cfg, so its PMP setup loses the
          # addresses; proven 2026-07-04: r.csr.pmpaddr(0)=0 after the write,
          # precalc = NAPOT-of-zero, S-fetch no-hit denied).  `/= '1'` is
          # identical for defined values and proceeds on the sim-only U.
          "-e \"s/pmp_locked(csr, csra_ilo) = '0' and/pmp_locked(csr, csra_ilo) \\/= '1' and/\" $(SRCS) " +
          "| python3 -c \"import sys; s = sys.stdin.read(); s = s.replace('  csr_mmu.precalc        <= r.csr.pmp_precalc;', '''  precalc_scrub : process (r)\\n    variable pc_v : pmp_precalc_vec(0 to PMPENTRIES - 1);\\n  begin\\n    pmp_precalc(r.csr.pmpaddr, r.csr.pmpcfg, pc_v,\\n                pmp_entries, pmp_no_tor, pmp_g, physaddr - 1);\\n    csr_mmu.precalc <= pc_v;\\n  end process;'''); s = s.replace('                csr.pmpaddr(csra_ilo) := (others =>', '-- pragma translate_off' + chr(10) + '                report ' + chr(34) + 'PMPW arm hit' + chr(34) + ' severity note;' + chr(10) + '-- pragma translate_on' + chr(10) + '                csr.pmpaddr(csra_ilo) := (others =>');" +
          # FIX (xsim -O0 record corruption, proven by tracer bisection 2026-07-05):
          # (a) tie_csrs's INOUT copy-back garbles v.csr.pmpaddr(0) every cycle
          #     (the body never touches pmpaddr) -> save/restore around the call;
          # (b) the pmpcfg SLICE tie's nested aggregate stomps the neighboring
          #     pmpaddr(0) field -> rewrite the three slice-ties as an indexed
          #     loop (no slice aggregates).  Both HW-equivalent.
          "s = s.replace('    variable wb_csr             : csr_reg_type;', '    variable wb_csr             : csr_reg_type;' + chr(10) + '    variable pmpaddr_keep_v     : gaisler.noelvint.pmpaddr_vec_type;');" +
          "s = s.replace('    tie_csrs(active_extensions, pmp_entries, pma_entries, pma_masked, perf_cnts, perf_bits, mmuen, v.csr);', '    pmpaddr_keep_v := v.csr.pmpaddr;' + chr(10) + '    tie_csrs(active_extensions, pmp_entries, pma_entries, pma_masked, perf_cnts, perf_bits, mmuen, v.csr);' + chr(10) + '    v.csr.pmpaddr := pmpaddr_keep_v;');" +
          "s = s.replace('      v.csr.pmpcfg(pmp_entries to PMPENTRIES - 1)      := (others => (others => ' + chr(39) + '0' + chr(39) + '));', '      for pmpi_v in pmp_entries to PMPENTRIES - 1 loop' + chr(10) + '        v.csr.pmpcfg(pmpi_v)  := (others => ' + chr(39) + '0' + chr(39) + ');' + chr(10) + '      end loop;');" +
          "s = s.replace('      v.csr.pmpaddr(pmp_entries to PMPENTRIES - 1)     := (others => pmpaddrzero);', '      for pmpj_v in pmp_entries to PMPENTRIES - 1 loop' + chr(10) + '        v.csr.pmpaddr(pmpj_v) := pmpaddrzero;' + chr(10) + '      end loop;');" +
          "s = s.replace('      v.csr.pmp_precalc(pmp_entries to PMPENTRIES - 1) := (others => pmp_precalc_none);', '      for pmpk_v in pmp_entries to PMPENTRIES - 1 loop' + chr(10) + '        v.csr.pmp_precalc(pmpk_v) := pmp_precalc_none;' + chr(10) + '      end loop;'); sys.stdout.write(s)\" > $@",
)

# Synthesis variant of iunv.  The ONLY transform the hardware build needs is the
# `vmode` -> `vmode_in` rename: Vivado's VHDL parser treats `vmode` as a reserved
# word and errors "syntax error near 'vmode'" (xvhdl + synth alike); `vmode`
# appears ONLY in iunv.vhd in all of grlib, so the rename is safe.  Everything
# else in :iunv_relaxed is SIM-ONLY X-robustness -- in particular `precalc_scrub`
# REMOVES a pipeline timing register (csr_mmu.precalc reg -> a combinational
# recompute), which must NOT reach a bitstream.  So the synth `gaisler` library
# consumes this minimal variant while only the sim libraries take the full
# :iunv_relaxed stack.
genrule(
    name = "iunv_synth",
    srcs = ["@@grlib++http_archive+grlib_srcs//:lib/gaisler/noelv/core/iunv.vhd"],
    outs = ["iunv_synth.vhd"],
    cmd = "sed -e 's/\\bvmode\\b/vmode_in/g' $(SRCS) > $@",
)

# stdio for the Vivado synth: comment out ALL of grlib stdio's HRead/HWrite/Write
# decls + bodies (the ranges bazel_grlib's patch_vhdl_2008.py targets) with NO
# aliases.  A Vivado update added HRead/HWrite/Write for std_(u)logic_vector to its
# std_logic_textio, colliding with grlib's -- a homograph plus a "multiple use
# clause" ambiguity that cascades through dma2ahb_tp, testlib, the disassemblers.
# Stripping grlib's lets every caller resolve to the std lib.  bazel_grlib's
# stdio_2008 aliases instead -- fine for NVC/2008, but Vivado synth's reader can't
# resolve the alias signatures (they need std.textio.Line).  Ranges target
# grlib-gpl-2025.2-b4298.  TODO: upstream a "strip" mode to patch_vhdl_2008.py.
genrule(
    name = "stdio_93",
    srcs = ["@@grlib++http_archive+grlib_srcs//:lib/grlib/stdlib/stdio.vhd"],
    outs = ["stdio_93.vhd"],
    cmd = "sed '39,42s/^/-- /;44,46s/^/-- /;48,50s/^/-- /;52,55s/^/-- /;57,59s/^/-- /;61,65s/^/-- /;67,71s/^/-- /;73,77s/^/-- /;141,191s/^/-- /;193,201s/^/-- /;203,213s/^/-- /;215,223s/^/-- /;225,235s/^/-- /;237,260s/^/-- /;262,269s/^/-- /;271,281s/^/-- /' $(SRCS) > $@",
)

