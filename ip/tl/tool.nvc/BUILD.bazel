        "//ip/tl:tl_ethernet.test.vhdl",
    ],
    entity = "tl_ethernet_test",
    deps = [
        "//testing/tool.nvc:testing",
        "//third_party/ethernet/tool.nvc:ethernet",
        "@rules_vunit//tool.nvc:vunit_lib",
        ":tl",
    ],
