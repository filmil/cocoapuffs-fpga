load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "memh_file")

package(default_visibility = ["//visibility:public"])

# Minimal M-mode handoff stub that mrets straight into the Fuchsia boot-shim at
# 0x240000, reproducing OpenSBI's S-mode handoff environment -- used to diagnose
# the shim's fault offline without the (too-slow-to-simulate) full OpenSBI boot.
# See //boards/noelv/tool.vivado:shim_fault_trace.
genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_shim_handoff.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64im_zicsr -mabi=lp64 -nostartfiles -nostdlib " +
          "-Wl,--section-start=.text=0x0 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)

memh_file(
    name = "memh",
    srcs = [":bin"],
)
