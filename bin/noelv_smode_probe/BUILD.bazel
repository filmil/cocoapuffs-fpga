load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "memh_file")

package(default_visibility = ["//visibility:public"])

# S-mode PMP-X probe: zeroes ALL pmpcfg/pmpaddr CSRs (kill the RTL-sim X in the
# unprogrammed entries), programs entry0 NAPOT RWX, then `mret`s into the shim
# at 0x240000 in S-MODE with the real DTB (fw_fdt_bin @0x5c000) in a1.  Decides
# whether the zircon_full_boot S-mode handoff trap-loop (mcause=1 @0x240000) is
# sim-X poisoning of the PMP check or a real core denial.
# See //boards/noelv/tool.vivado:smode_pmp_probe and bin/noelv_smode_probe/main.S.
genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_smode_probe.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64im_zicsr -mabi=lp64 -nostartfiles -nostdlib " +
          "-Wl,--section-start=.text=0x0 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)

memh_file(
    name = "memh",
    srcs = [":bin"],
)
