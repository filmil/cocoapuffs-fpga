load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "hex_file", "memh_file")

package(default_visibility = ["//visibility:public"])

# HW clean re-measurement of APBUART (PLIC source 1) interrupt delivery.  Linked
# at 0x40000 so the SERV ihex loader uploads it and the boot stub jumps to it in
# M-mode (no OpenSBI).  Arms M-software, M-external and S-external interrupts and,
# for the external phases, reads mip/sip + PLIC pending (NEVER claim) before
# enabling the trap.  Upload `:hex`; expect on the UART:
#   IRQTEST
#   A: TRAP c=00000003            (HW takes interrupts)
#   B mip=<...> pend=<...>        (bit11 of mip / bit1 of pend = MEIP / source 1)
#   B: TRAP c=0000000b src=00000001
#   C sip=<...> pend=<...>        (bit9 of sip = SEIP)
#   C: TRAP c=00000009 src=00000001
#   DONE
genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_irqtest.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64ima_zicsr -mabi=lp64 -nostartfiles -nostdlib " +
          "-Wl,--section-start=.text=0x40000 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)

# Intel HEX (loads at 0x40000) for serial upload via the SERV ihex loader.
hex_file(
    name = "hex",
    srcs = [":bin_raw"],
)

memh_file(
    name = "memh",
    srcs = [":bin"],
)
