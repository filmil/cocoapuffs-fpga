load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "hex_file", "memh_file")

package(default_visibility = ["//visibility:public"])

# Standalone DDR3 RW/heap-region memory test (0x80000-0x92000), linked at 0x40000
# so the SERV ihex loader uploads it and the boot stub jumps to it -- no OpenSBI.
# Isolates the on-hardware sbi_domain_init failure to the memory subsystem.
# Upload `:hex` like opensbi_fw_hello.hex; expect "MEM OK" or "BAD <addr> <got>".
genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_memtest.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64im_zicsr -mabi=lp64 -nostartfiles -nostdlib " +
          "-Wl,--section-start=.text=0x40000 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)

# Intel HEX (loads at 0x40000) for serial upload via the SERV ihex loader.
hex_file(
    name = "hex",
    srcs = [":bin_raw"],
)

memh_file(
    name = "memh",
    srcs = [":bin"],
)
