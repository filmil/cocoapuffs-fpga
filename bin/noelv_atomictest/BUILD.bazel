load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "hex_file", "memh_file")

package(default_visibility = ["//visibility:public"])

# Standalone RISC-V atomics (amoswap/amoadd) test on DDR3 0x80000, linked at
# 0x40000 (no OpenSBI).  Isolates whether the on-hardware sbi_domain_init lock/
# FIFO churn is a missing-AMO-support issue in the AHB->DDR3 path.  Upload `:hex`;
# expect "ATOMIC OK" or "ATOMIC BAD <which>".  Needs the A extension.
genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_atomictest.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64ima_zicsr -mabi=lp64 -nostartfiles -nostdlib " +
          "-Wl,--section-start=.text=0x40000 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)

hex_file(
    name = "hex",
    srcs = [":bin_raw"],
)

memh_file(
    name = "memh",
    srcs = [":bin"],
)
