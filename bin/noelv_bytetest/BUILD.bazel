load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "hex_file", "memh_file")

package(default_visibility = ["//visibility:public"])

# Standalone DDR3 *byte-write* (sub-word store) test, linked at 0x40000 so the
# SERV ihex loader uploads it and the boot stub jumps to it -- no OpenSBI.
# Confirms the root cause of the sbi_domain_init failure: sbi_memcpy (byte-wise)
# corrupts DDR3 while aligned sw/sd work.  Upload `:hex`; expect "BYTE OK" or
# "BYTE BAD <case> <got> <expected>".
genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_bytetest.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64im_zicsr -mabi=lp64 -nostartfiles -nostdlib " +
          "-Wl,--section-start=.text=0x40000 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)

# Intel HEX (loads at 0x40000) for serial upload via the SERV ihex loader.
hex_file(
    name = "hex",
    srcs = [":bin_raw"],
)

memh_file(
    name = "memh",
    srcs = [":bin"],
)
