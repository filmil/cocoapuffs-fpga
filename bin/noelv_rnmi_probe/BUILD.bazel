load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "hex_file")

package(default_visibility = ["//visibility:public"])

# RNMI trap-handler probe: printing handlers planted at this core's hardwired
# RNMI vectors PC_RNMI_ITRAP=0x30010000 / PC_RNMI_XTRAP=0x30011000 (DDR3), to
# catch the Smrnmi/Smdbltrp silent wedge and dump mncause/mnepc.  Merge the
# EOF-stripped :hex ahead of a boot image's ihex.
genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_rnmi_probe.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64ima_zicsr -mabi=lp64 -nostartfiles -nostdlib " +
          "-Wl,--section-start=.text=0x30010000 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)

hex_file(
    name = "hex",
    srcs = [":bin_raw"],
)
