load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "hex_file", "memh_file")

package(default_visibility = ["//visibility:public"])

# Standalone LR/SC (load-reserved/store-conditional) test on DDR3 0x80000, linked
# at 0x40000 so the SERV ihex loader uploads it and the boot stub jumps to it --
# no OpenSBI. Confirms whether lr.d/sc.d reservations are maintained on uncached
# DDR3 (the suspected cause of OpenSBI's atomic_cmpxchg wedge at the S-mode
# handoff). Upload `:hex`; expect "LRSC OK <n>" or "LRSC BAD ...".
genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_lrsctest.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64ima_zicsr -mabi=lp64 -nostartfiles -nostdlib " +
          "-Wl,--section-start=.text=0x40000 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)

hex_file(
    name = "hex",
    srcs = [":bin_raw"],
)

memh_file(
    name = "memh",
    srcs = [":bin"],
)
