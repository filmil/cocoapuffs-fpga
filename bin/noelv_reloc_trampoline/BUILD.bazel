load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "hex_file")

package(default_visibility = ["//visibility:public"])

# 2-instruction trampoline linked at 0x40000: jumps to OpenSBI relocated high
# (0x3D000000) so Zircon physboot's low-RAM kernel relocation does not overwrite
# OpenSBI. See main.S. Used by //boards/noelv:opensbi_fw_zircon_reloc_hex.
genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_reloc_trampoline.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64im -mabi=lp64 -nostartfiles -nostdlib " +
          "-Wl,--section-start=.text=0x40000 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

hex_file(
    name = "hex",
    srcs = [":bin_raw"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)
