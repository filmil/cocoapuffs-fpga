load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_cc//cc:defs.bzl", rv32_cc_binary = "cc_binary")
load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "hex_file", "memh_file")

package(default_visibility = ["//visibility:public"])

rv32_cc_binary(
    name = "bin_orig",
    srcs = ["main.cc"],
    copts = [
        "-DUART_ADDRESS=0x40000010",
        "-Wl,--emit-relocs",
        "-Wno-write-strings",
        "-fPIE",
        "-mabi=ilp32",
        "-march=rv32i_zicsr",
        "-mcmodel=medany",
    ],
    linkopts = [
        "-Wl,--emit-relocs",
        "-mabi=ilp32",
        "-march=rv32i_zicsr",
        "-mcmodel=medany",
    ],
    tags = ["manual"],
    deps = [
        #"//lib",
        "//lib/uart:lib",
        "//third_party/riscv32_toolchain:startup",
    ],
)

platform_transition_filegroup(
    name = "rv32i",
    srcs = [":bin_orig"],
    target_platform = "//third_party/riscv32_toolchain/platform:rv32i",
    visibility = ["//visibility:public"],
)

hex_file(
    name = "hex",
    srcs = [
        ":rv32i",
    ],
)

bin_file(
    name = "bin",
    srcs = [
        ":rv32i",
    ],
)

disasm_file(
    name = "disasm",
    srcs = [
        ":rv32i",
    ],
)

memh_file(
    name = "memh",
    srcs = [
        ":bin",
    ],
)
