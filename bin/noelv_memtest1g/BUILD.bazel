load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "hex_file", "memh_file")

package(default_visibility = ["//visibility:public"])

# Standalone full-1GB DDR3 aliasing + read/write test, linked at 0x40000 so the
# SERV ihex loader + boot stub jump to it directly (no OpenSBI). Caches are
# disabled so accesses hit DDR3 through the WB adapter. Upload `:hex`; expect
# "ALL OK -- full 1GB addressable, no aliasing", or "BANK BAD .."/"MARCH BAD ..".
genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_memtest1g.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64im_zicsr -mabi=lp64 -nostartfiles -nostdlib " +
          "-Wl,--section-start=.text=0x40000 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)

# Intel HEX (loads at 0x40000) for serial upload via the SERV ihex loader.
hex_file(
    name = "hex",
    srcs = [":bin_raw"],
)

memh_file(
    name = "memh",
    srcs = [":bin"],
)
