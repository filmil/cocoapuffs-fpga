load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "hex_file", "memh_file")

package(default_visibility = ["//visibility:public"])

# Shim-trap HW probe: the real Fuchsia boot-shim (.incbin at 0x240000) plus a
# minimal M-mode handoff stub + trap handler at 0x40000.  Uploaded via the SERV
# ihex loader (no OpenSBI); mrets into the shim in S-mode and prints
# "SHIM TRAP <mcause> <mepc> <mtval>" on its first fault -- to find where the
# shim's silent recurring trap actually is (S-mode execute works on HW per
# noelv_smodetest, so the shim runs and faults later).  Upload `:hex`.
genrule(
    name = "bin_raw",
    srcs = [
        "main.S",
        "//third_party/fuchsia:riscv64-boot-shim",
    ],
    outs = ["noelv_shimtrap.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64ima_zicsr -mabi=lp64 -nostartfiles -nostdlib " +
          "-DSHIM_BIN='\"$(location //third_party/fuchsia:riscv64-boot-shim)\"' " +
          "-Wl,--section-start=.text=0x40000 -Wl,--section-start=.shim=0x240000 " +
          "-o $@ $(location main.S)",
    tools = ["@riscv_none_elf//:gcc"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)

hex_file(
    name = "hex",
    srcs = [":bin_raw"],
)

memh_file(
    name = "memh",
    srcs = [":bin"],
)
