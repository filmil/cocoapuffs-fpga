load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "memh_file")

package(default_visibility = ["//visibility:public"])

# RV64 NOEL-V memory write/read self-test program (boots from the boot BRAM,
# writes+reads 0x40000, prints "DDR OK"/"DDR BAD" then "halt.").
genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_ddr3test.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64im -mabi=lp64 -nostartfiles -nostdlib " +
          "-Wl,--section-start=.text=0x0 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)

memh_file(
    name = "memh",
    srcs = [":bin"],
)
