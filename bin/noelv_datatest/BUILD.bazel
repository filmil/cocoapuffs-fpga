load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "hex_file", "memh_file")

package(default_visibility = ["//visibility:public"])

# Standalone test that the SERV ihex loader correctly loads a .data section at
# 0x80000 (the ihex 0x8000-segment, where OpenSBI's RW data lives), as distinct
# from .text at 0x40000.  Upload `:hex`; expect "DATA OK" or
# "DATA BAD <addr> <got> <expected>".
genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_datatest.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64im_zicsr -mabi=lp64 -nostartfiles -nostdlib " +
          "-Wl,--section-start=.text=0x40000 -Wl,--section-start=.data=0x80000 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)

hex_file(
    name = "hex",
    srcs = [":bin_raw"],
)

memh_file(
    name = "memh",
    srcs = [":bin"],
)
