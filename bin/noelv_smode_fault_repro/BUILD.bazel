load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "memh_file")

package(default_visibility = ["//visibility:public"])

# S-mode fault REPRO for VCD/X analysis: entry0-only PMP (entries 1..15 left
# unprogrammed = X in RTL sim) + `mret` into the shim in S-mode -- reproduces
# the zircon_full_boot handoff trap-loop in ~us so the VCD run can show where
# X appears in the PMP/fetch-permission chain.
# See //boards/noelv/tool.vivado:smode_fault_vcd and bin/noelv_smode_probe.
genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_smode_fault_repro.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64im_zicsr -mabi=lp64 -nostartfiles -nostdlib " +
          "-Wl,--section-start=.text=0x0 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)

memh_file(
    name = "memh",
    srcs = [":bin"],
)
