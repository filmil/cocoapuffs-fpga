load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "hex_file", "memh_file")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load(":baud.bzl", "boot_in_mode")

package(default_visibility = ["//visibility:public"])

# UART baud mode for the boot program:
#   sim (default) -> fast rate matched to the testbench's 200 kbaud receiver
#   hw            -> realistic 115200 bps
# Override globally with --//bin/noelv_boot:uart_mode=hw, or use the pinned
# transition targets below (e.g. :memh_hw) to build a specific mode directly.
string_flag(
    name = "uart_mode",
    build_setting_default = "sim",
    values = [
        "sim",
        "hw",
    ],
)

config_setting(
    name = "uart_hw",
    flag_values = {":uart_mode": "hw"},
)

genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_boot.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64im_zicsr -mabi=lp64 -nostartfiles -nostdlib " +
          select({
              ":uart_hw": "-DSIM_FAST=0 ",
              "//conditions:default": "-DSIM_FAST=1 ",
          }) +
          "-Wl,--section-start=.text=0x0 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

hex_file(
    name = "hex",
    srcs = [
        ":bin_raw",
    ],
)

bin_file(
    name = "bin",
    srcs = [
        ":bin_raw",
    ],
)

disasm_file(
    name = "disasm",
    srcs = [
        ":bin_raw",
    ],
)

memh_file(
    name = "memh",
    srcs = [
        ":bin",
    ],
)

# Transition targets: build a specific baud mode regardless of the global flag.
# `:memh` (and the rest) follow --//bin/noelv_boot:uart_mode (default "sim").
boot_in_mode(
    name = "memh_sim",
    dep = ":memh",
    uart_mode = "sim",
)

boot_in_mode(
    name = "memh_hw",
    dep = ":memh",
    uart_mode = "hw",
)

boot_in_mode(
    name = "disasm_hw",
    dep = ":disasm",
    uart_mode = "hw",
)
