load("//third_party/riscv32_toolchain:macros.bzl", "bin_file", "disasm_file", "hex_file", "memh_file")

package(default_visibility = ["//visibility:public"])

# Standalone S-mode-execute probe, linked at 0x40000 so the SERV ihex loader
# uploads it and the boot stub jumps to it -- no OpenSBI.  M-mode sets a catch-all
# RWX PMP and mrets to S-mode in DDR3.  Upload `:hex`; expect "SMODE OK" (S-mode
# execute works) or "SMODE FAULT <mcause> <mepc> <mtval>" (denied -- confirms the
# Fuchsia shim's recurring trap is a platform S-mode-execute issue).
genrule(
    name = "bin_raw",
    srcs = ["main.S"],
    outs = ["noelv_smodetest.elf"],
    cmd = "$(execpath @riscv_none_elf//:gcc) -march=rv64ima_zicsr -mabi=lp64 -nostartfiles -nostdlib " +
          "-Wl,--section-start=.text=0x40000 -o $@ $<",
    tools = ["@riscv_none_elf//:gcc"],
)

bin_file(
    name = "bin",
    srcs = [":bin_raw"],
)

disasm_file(
    name = "disasm",
    srcs = [":bin_raw"],
)

hex_file(
    name = "hex",
    srcs = [":bin_raw"],
)

memh_file(
    name = "memh",
    srcs = [":bin"],
)
