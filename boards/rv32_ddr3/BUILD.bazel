load("@rules_nvc//build/nvc:rules.bzl", "wave_view")

#load("@com_github_filmil_go_vcd_parser//:macros.bzl", "vcd_go_test", "vcd_index")
load(
    "@rules_vivado//build/vivado:rules.bzl",
    "vivado_generics",
    "vivado_library",
    "vivado_place_and_route",
    "vivado_place_and_route2",
    "vivado_program_device",
    "vivado_simulation",

    # Version2
    "vivado_synthesis2",
)

package(default_visibility = ["//visibility:public"])

_MEMH = "//bin/rv32_ddr3/software:memh"

_GENERICS = {
    "RESET_STRATEGY": "MINI",
    "MEMFILE": "$(location {})".format(_MEMH),
    "MEMSIZE": "262144",
}

filegroup(
    name = "rv32_ddr3_files",
    # do not sort
    srcs = [
        "//ip/a200t:entity_vhdl",
        "board.arch_rtl.vhdl",
    ],
    tags = [
        "vhdl_ls",
        "vhdl_ls_lib_rv32_ddr3",
    ],
)

vivado_library(
    name = "rv32_ddr3",
    standard = "2008",
    # do not sort
    srcs = [
        ":rv32_ddr3_files",
        "//ip/a200t:entity_vhdl",
        "board.arch_rtl.vhdl",
    ],
    deps = [
        "//ip/a200t",
        "//ip/a200t:constants",
        "//ip/axi",
        "//ip/ddr3",
        "//ip/wb/tool.vivado:wb",
        "//ip/wb_uart/vivado:wb_uart",
        "//third_party/serv:serv_vivado",
        "//third_party/serv:servile_vivado",
        "//third_party/serv:serving_vivado",
        "//third_party/uart:third_party_uart",
        "//third_party/uberddr3",
        "//third_party/xilinx:unisim",
    ],
)

filegroup(
    name = "tb_srcs",
    # do not sort
    srcs = [
        "tb.vhdl",
        "tb.arch_sim.vhdl",
    ],
)

vivado_library(
    name = "tb",
    standard = "2008",
    # do not sort
    srcs = [
        ":tb_srcs",
    ],
    data = [
        _MEMH,
    ],
    deps = [
        ":rv32_ddr3",
        "//ip/a200t",
        "//ip/a200t:constants",
        "//ip/axi",
        "//ip/ddr3",
        "//ip/wb/tool.vivado:wb",
        "//ip/wb_uart/vivado:wb_uart",
        "//testing/a200t:a200t_clk",
        "//testing/a200t:a200t_ddr3",
        "//testing/adt/tool.vivado:adt",
        "//testing/tool.vivado:testing",
        "//third_party/serv:serv_vivado",
        "//third_party/serv:servile_vivado",
        "//third_party/serv:serving_vivado",
        "//third_party/uart:third_party_uart",
        "//third_party/uberddr3",
        "//third_party/vunit/tool.vivado:vunit_lib",
        "//third_party/xilinx:unisim",
    ],
)

# Runs at about 1h real time for 100us simulated.
vivado_simulation(
    name = "sim",
    config = "cfg_tb",
    data = [
        _MEMH,
    ],
    extra_modules = ["glbl.glbl"],
    generic_tops = _GENERICS | {
        "sim_duration_ns": "400000",
    },
    library = ":tb",
    top = "tb",
    xelab_relaxed = True,
)

filegroup(
    name = "vcd",
    srcs = [":sim"],
    output_group = "vcd",
)

wave_view(
    name = "view",
    args = [
        "--save=$(location full_wave.gtkw)",
    ],
    vhdl_run = ":vcd",
    deps = [
        "full_wave.gtkw",
    ],
)

