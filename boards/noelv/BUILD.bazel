    properties = {
        "/|model": "HDLFactory Cocoapuffs: FPGA Soft Core RISC-V Board",
        "/|compatible": "hdlf,cocoapuffs",
    },
)

filegroup(
    name = "noelv_files",
    # do not sort
    srcs = [
        "//ip/a200t:entity_vhdl",
        "board.arch_rtl.vhdl",
    ],
    tags = [
        "vhdl_ls",
        "vhdl_ls_lib_noelv",
    ],
)

filegroup(
    name = "tb_srcs",
    # do not sort
    srcs = [
        "tb.vhdl",
        "tb.arch_sim.vhdl",
    ],
    tags = [
        "vhdl_ls",
        "vhdl_ls_lib_noelv_tb",
    ],
)

filegroup(
    name = "tb_noelvsys_ddr3_srcs",
    # do not sort
    srcs = [
        "tb_noelvsys_ddr3.vhdl",
    ],
)

filegroup(
    name = "tb_noelvsys_only_srcs",
    # do not sort
    srcs = [
        "tb_noelvsys_only.vhdl",
    ],
    tags = [
        "vhdl_ls",
        "vhdl_ls_lib_noelv_tb_only",
    ],
)

filegroup(
    name = "vcd",
    srcs = ["//boards/noelv/tool.vivado:sim"],
    output_group = "vcd",
)

filegroup(
    name = "vcd_only",
    srcs = ["//boards/noelv/tool.vivado:sim_only"],
    output_group = "vcd",
)

wave_view(
    name = "view",
    args = [
        "--save=$(location full_wave.gtkw)",
    ],
    vhdl_run = ":vcd",
    deps = [
        "full_wave.gtkw",
    ],
)

wave_view(
    name = "view_only",
    args = [
        "--save=$(location full_wave.gtkw)",
    ],
    vhdl_run = ":vcd_only",
    deps = [
        "full_wave.gtkw",
    ],
)

# VUnit-free NVC copy of the noelvsys tb (see tb_noelvsys_nvc.vhdl); consumed by
# //boards/noelv/tool.nvc/boot.  Restored here: the file was dropped from main
# together with the earlier NVC scaffolding.
filegroup(
    name = "tb_noelvsys_nvc_srcs",
    srcs = ["tb_noelvsys_nvc.vhdl"],
    visibility = ["//visibility:public"],
)

# The ZBI as a dense .mem for the sim's zbi bank (0x10000000-0x103FFFFF) -- keeps
# the ZBI at its real address without a >256 MiB single array (xsim's 2**31-bit
# cap).  Restored: main kept only the ihex variant.  Used by the zircon sim
# targets in //boards/noelv/tool.vivado.
genrule(
    name = "kernel_zbi_mem",
    srcs = ["//third_party/fuchsia:kernel-zbi"],
    outs = ["kernel_zbi.mem"],
    cmd = "$(execpath //tools/bintomemh) < $< > $@",
    tools = ["//tools/bintomemh"],
)
