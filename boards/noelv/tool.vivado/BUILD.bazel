    "RESET_STRATEGY": "MINI",
    "MEMFILE": "$(location {})".format(_MEMH),
    "MEMSIZE": "65536",
    "HEXFILE": "$(location {})".format(_HEXFILE),
    "NOELV_MEMFILE": "$(location {})".format(_NOELV_BOOT_MEMH),
    "NOELV_MEMSIZE": "4096",
}

