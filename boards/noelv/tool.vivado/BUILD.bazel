# Waveform/trace sibling of :ddr3test -- runs the same DDR3 write/read self-test
# (noelv_ddr3test: sw 0xCAFEF00D -> 0x40000, lw back, "halt." on match) on the
# NOEL-V-only testbench, but as a vivado_simulation with a short duration so the
# tb_noelvsys_only AHB monitor's log is easy to read.  The monitor prints every
# low-region access on noelv_ahbsi with hready + hrdata (which the HW recorder
# cannot see), so we can tell whether the store ISSUES and COMPLETES -- i.e.
# whether the on-hardware "DDR3 write never reaches the bus" hang reproduces in
# pure simulation against a plain writable BRAM (no DDR3 PHY).
vivado_simulation(
    name = "ddr3test_trace",
    data = [
        "//bin/noelv_ddr3test:memh",
    ],
    extra_modules = ["glbl.glbl"],
    generic_tops = {
        # 500 us: at 200 kbaud each UART byte is ~50 us, so "halt.\r\n" (7 B,
        # held in the 8-deep TX FIFO) needs ~350 us to fully transmit.
        "sim_duration_ns": "500000",
        "noelv_memfile": "$(location //bin/noelv_ddr3test:memh)",
        "noelv_memsize": "4096",
    },
    library = ":tb_only",
    top = "tb_noelvsys_only",
    xelab_args = [
        "-mt",
        "off",
        "-debug",
        "typical",
        "-O0",
    ],
    xelab_relaxed = True,
    # 500 us of sim takes ~3.5 min wall-clock; keep it off wildcard (//...) runs.
    tags = ["manual"],
)

# OpenSBI bring-up simulation: NOEL-V-only testbench (behavioral BRAM, no SERV,
# no DDR3 PHY) with OpenSBI pre-loaded into the low "DDR3" RAM at 0x40000 and a
# minimal boot stub (//bin/noelv_sim_boot) in the boot BRAM that jumps straight
# there.  `disas=1` prints the full retired-instruction trace and the tb's
# ahb_monitor prints every bus transfer, so we can see exactly where OpenSBI's
# coldboot dies (sbi_domain_init) -- offline, without the hardware. The low RAM
# is 2 MiB with reg_bit_count=21 so 0x40000 decodes without aliasing.
#   bazel run //boards/noelv/tool.vivado:opensbi_trace 2>&1 | tee /tmp/osbi.log
_OPENSBI_LOWRAM_MEM = "//boards/noelv:opensbi_fw_hello_lowram_mem"
_SIM_BOOT_MEMH = "//bin/noelv_sim_boot:memh"

vivado_simulation(
    name = "opensbi_trace",
    data = [
        _SIM_BOOT_MEMH,
        _OPENSBI_LOWRAM_MEM,
    ],
    extra_modules = ["glbl.glbl"],
    generic_tops = {
        # 10 ms.  With libfdt ASSUME_PERFECT + the 4 skipped early-init scans,
        # generic_early_init shrinks from ~6 ms to ~1 ms: domain_init ~3 ms, early
        # init ~4 ms, sbi_hart_init/banner ~5 ms, domain_finalize +
        # sbi_hart_pmp_configure ~8 ms.  Goal: see WHERE the boot actually hangs
        # (hang_addr catches an sbi_hart_hang spin; a silent wedge = trace stops;
        # full boot = banner UART writes + payload).
        "sim_duration_ns": "10000000",
        "noelv_memfile": "$(location {})".format(_SIM_BOOT_MEMH),
        "noelv_memsize": "4096",
        "lowmem_file": "$(location {})".format(_OPENSBI_LOWRAM_MEM),
        # 36 MiB / regbits=26 (decodes haddr[25:2], no aliasing below 0x2400000).
        # Must cover OpenSBI's FDT RELOCATION target: fw_base.S copies the FDT to
        # fw_next_arg1() = 0x2240000 (~35.8 MB, valid DRAM on HW).  A smaller RAM
        # aliases 0x2240000 mod size back onto the 0x40000 code and crashes the
        # sim (illegal instruction in _start_warm) -- a sim artifact, not the bug.
        "lowmem_size": "37748736",  # 0x2400000 (36 MiB)
        "lowmem_regbits": "26",
        "disas": "1",
        # sbi_hart_hang @0x4e706 (= 321286) -- finish when the core spins here.
        "hang_addr": "321286",
    },
    library = ":tb_only",
    top = "tb_noelvsys_only",
    xelab_args = [
        "-mt",
        "off",
        # -O0 only: both -O2 and -O3 FATAL_ERROR at time 0 in iunv_relaxed.vhd
        # (xsim mis-optimizes the relaxed NOEL-V integer-unit compile).  So the
        # sim is slow; instead we bound wall time with hang-detection in the
        # testbench (hang_addr) + a generous duration that stops at the hang.
        "-O0",
    ],
    xelab_relaxed = True,
    tags = ["manual"],
)

# Fuchsia boot-shim diagnosis sim: OpenSBI + the REAL //third_party/fuchsia
# riscv64-boot-shim payload (not the hello build) in the NOEL-V-only tb, disas=1.
# Runs past the S-mode handoff to capture WHERE the shim faults -- the post-MEDELEG
# recurring trap seen on HW (log42).  The tb uses ahb_bram (byte-writes + LR/SC
# both work), so this looks *past* the bridge bugs the cache fix targets and shows
# the shim's intrinsic fault.  No hang_addr (the shim's trap PC is unknown), so the
# sim runs the full duration; the trace shows boot + handoff + the first traps.
#   bazel run //boards/noelv/tool.vivado:opensbi_trace_fuchsia 2>&1 | tee /tmp/fx.log
_OPENSBI_FUCHSIA_LOWRAM_MEM = "//boards/noelv:opensbi_fw_lowram_mem"

vivado_simulation(
    name = "opensbi_trace_fuchsia",
    data = [
        _SIM_BOOT_MEMH,
        _OPENSBI_FUCHSIA_LOWRAM_MEM,
    ],
    extra_modules = ["glbl.glbl"],
    generic_tops = {
        "sim_duration_ns": "12000000",  # 12 ms: boot ~8 ms, then handoff + shim fault
        "noelv_memfile": "$(location {})".format(_SIM_BOOT_MEMH),
        "noelv_memsize": "4096",
        "lowmem_file": "$(location {})".format(_OPENSBI_FUCHSIA_LOWRAM_MEM),
        "lowmem_size": "37748736",  # 0x2400000 (36 MiB), covers FDT reloc @0x2240000
        "lowmem_regbits": "26",
        "disas": "1",
    },
    library = ":tb_only",
    top = "tb_noelvsys_only",
    xelab_args = [
        "-mt",
        "off",
        "-O0",
    ],
    xelab_relaxed = True,
    tags = ["manual"],
)

# rung-3 reservation debug in sim: OpenSBI + real boot-shim + board_zircon_dtb (so
# OpenSBI's mmode_resv /reserved-memory is in the FDT the shim parses).  No ZBI in
# the 36 MiB sim RAM, so the shim will fault when it dereferences the /chosen initrd
# at 0x10000000 -- but its memory matcher + MEM_CONFIG build run BEFORE that, so the
# disas trace shows exactly what the matcher does with OpenSBI's reservation
# (the HW-unobservable step, sidestepping the rung-3 UART silence + slow uploads).
#   bazel run //boards/noelv/tool.vivado:opensbi_trace_zircon 2>&1 | tee /tmp/z.log
_OPENSBI_ZIRCON_LOWRAM_MEM = "//boards/noelv:opensbi_fw_zircon_lowram_mem"

vivado_simulation(
    name = "opensbi_trace_zircon",
    data = [
        _SIM_BOOT_MEMH,
        _OPENSBI_ZIRCON_LOWRAM_MEM,
    ],
    extra_modules = ["glbl.glbl"],
    generic_tops = {
        "sim_duration_ns": "12000000",  # 12 ms: boot ~8 ms, then handoff + shim matcher
        "noelv_memfile": "$(location {})".format(_SIM_BOOT_MEMH),
        "noelv_memsize": "4096",
        "lowmem_file": "$(location {})".format(_OPENSBI_ZIRCON_LOWRAM_MEM),
        "lowmem_size": "37748736",  # 0x2400000 (36 MiB), covers FDT reloc @0x2240000
        "lowmem_regbits": "26",
        "disas": "1",
    },
    library = ":tb_only",
    top = "tb_noelvsys_only",
    xelab_args = [
        "-mt",
        "off",
        "-O0",
    ],
    xelab_relaxed = True,
    tags = ["manual"],
)

# FAITHFUL full-system duplicate of the HARDWARE boot: the exact image (OpenSBI +
# shim + the REAL ZBI @0x10000000 + board_zircon_dtb), OpenSBI actually running its
# FDT fixups + S-mode handoff -> shim -> physboot.  The ZBI sits at its true address
# via a SECOND low-RAM bank (a single ahb_bram caps at 256 MiB = xsim's 2**31-bit
# array limit): lowmem backs 0x0-0xFFFFFFF (boot + placement), zbimem backs
# 0x10000000-0x103FFFFF (the ZBI).  disas=0 (the full ~8ms boot is too long for a
# per-insn trace); the tb's ahb_monitor prints every low-region store, so physboot's
# placement -- e.g. a write to 0x0 -- is directly visible as "AHBMON ... WR 0x...",
# letting us re-examine the placement diagnosis with real visibility, not JTAG.
#   bazel build //boards/noelv/tool.vivado:opensbi_trace_zircon_zbi
_KERNEL_ZBI_MEM = "//boards/noelv:kernel_zbi_mem"

vivado_simulation(
    name = "opensbi_trace_zircon_zbi",
    data = [
        _SIM_BOOT_MEMH,
        _OPENSBI_ZIRCON_LOWRAM_MEM,
        _KERNEL_ZBI_MEM,
    ],
    extra_modules = ["glbl.glbl"],
    generic_tops = {
        # 50 ms: measured (2026-07-02 run) the OpenSBI banner lands at ~17.8 ms,
        # not ~8 ms: 0-9.8 ms fw_platform_init + fdt_serial_init scans, 9.9 ms
        # coldboot tracer S..D (sbi_domain_init PASSES -- the old xsim fdt hang
        # did not recur), 17.8 ms banner, 20 ms cut mid boot-prints.  50 ms
        # budgets banner + domain prints + handoff + shim + physboot placement
        # (~10 min/ms xsim wall, ~8 h total).
        "sim_duration_ns": "50000000",
        "noelv_memfile": "$(location {})".format(_SIM_BOOT_MEMH),
        "noelv_memsize": "4096",
        # Bank 1 (lowmem): firmware (OpenSBI+shim+DTB, NO ZBI) at 0x40000.  64 MiB
        # array (regbits 26 -> 64 MiB index range = array, no out-of-bounds).  A
        # 256 MiB array passes the VHDL size check but xsim's C backend fails on the
        # 67M-element zero-init (load_mem tmp:=(others=>0)); 64 MiB (16M, ~1.7x the
        # proven 36 MiB sims) covers boot + FDT@0x2240000 + a placement up to 64 MiB.
        # hmask=0xF00 decodes 0x0-0xFFFFFFF, so a placement in 64-256 MiB still shows
        # its real addr in the ahb_monitor (data aliases); the 0x0 bug lands < 64 MiB.
        "lowmem_file": "$(location {})".format(_OPENSBI_ZIRCON_LOWRAM_MEM),
        "lowmem_size": "67108864",  # 0x4000000 (64 MiB) -- matches regbits 26 decode, no out-of-bounds in 0x0-0x3FFFFFFF
        "lowmem_regbits": "26",
        # Bank 2 (zbimem): the REAL ZBI at its true 0x10000000-0x103FFFFF (4 MiB).
        "zbi_file": "$(location {})".format(_KERNEL_ZBI_MEM),
        "zbi_size": "4194304",  # 4 MiB (ZBI is ~1.85 MB)
        "zbi_regbits": "22",  # haddr[21:2] indexes the 4 MiB bank
        "zbi_haddr": "256",  # 0x100 -> haddr[31:20]=0x100 = 0x10000000
        "zbi_hmask": "4092",  # 0xFFC -> 4 MiB window 0x10000000-0x103FFFFF
        "disas": "0",
    },
    # No-VCD run script: the default tcl dumps every core signal (multi-GB + huge
    # per-cycle overhead -> the ~8ms boot takes hours).  We only need the
    # ahb_monitor stdout (the placement), so just `run -all`.
    custom_tcl_script = "sim_no_vcd.tcl",
    library = ":tb_only",
    top = "tb_noelvsys_only",
    xelab_args = [
        "-mt",
        "off",
        "-O0",
    ],
    xelab_relaxed = True,
    tags = ["manual"],
)

# THE full faithful Zircon boot sim (user-requested 2026-07-03: "one full proven
# boot in the simulator, no matter how long"): full OpenSBI (S-mode handoff,
# resident SBI runtime) -> shim -> physboot -> Zircon, with the SIM memory map
# (opensbi_fw_zircon_sim / board_zircon_sim_dtb: declared RAM == what the banks
# serve: 64 MiB low + 4 MiB ZBI@0x10000000) so a multi-day run never touches
# aliased/unmapped space.  Timeline (measured, ~10 min/ms xsim wall): banner
# ~17.8 ms, driver scans past ~47 ms; handoff, shim, physboot follow -- watch
# AHBMON for the first 0x240000 fetch (shim), 0x10000000 reads (ZBI), and the
# kernel placement writes.  600 ms budget = run until proven or refuted; kill it
# when the answer is in.
vivado_simulation(
    name = "zircon_full_boot",
    data = [
        _SIM_BOOT_MEMH,
        "//boards/noelv:opensbi_fw_zircon_sim_lowram_mem",
        _KERNEL_ZBI_MEM,
    ],
    extra_modules = ["glbl.glbl"],
    generic_tops = {
        # 2 s sim = watchdog only; we monitor AHBMON and stop the sim once the
        # boot is proven (or refuted).  Undersizing would force a restart of a
        # multi-day run; oversizing costs nothing.
        "sim_duration_ns": "2000000000",
        "noelv_memfile": "$(location {})".format(_SIM_BOOT_MEMH),
        "noelv_memsize": "4096",
        "lowmem_file": "$(location //boards/noelv:opensbi_fw_zircon_sim_lowram_mem)",
        "lowmem_size": "67108864",  # 64 MiB array == the declared memory@a0000
        "lowmem_regbits": "26",
        "zbi_file": "$(location {})".format(_KERNEL_ZBI_MEM),
        "zbi_size": "4194304",  # 4 MiB == the declared memory@10000000
        "zbi_regbits": "22",
        "zbi_haddr": "256",  # 0x10000000, the REAL HW ZBI address
        "zbi_hmask": "4092",
        "disas": "0",
    },
    custom_tcl_script = "sim_no_vcd.tcl",
    library = ":tb_only",
    top = "tb_noelvsys_only",
    xelab_args = [
        "-mt",
        "off",
