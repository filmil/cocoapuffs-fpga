# SERV core program. Default (used by the self-checking :sim / :test) is the
# banner-only noelv_serv_boot, which auto-hands off to NOEL-V so the sim sees
# the NOEL-V "halt." banner without an upload. The :synth (hardware) target
# overrides MEMFILE/HEXFILE to the Intel HEX uploader (//bin/noelv_serv_upload),
# which receives the real payload over UART before enabling NOEL-V.
_MEMH = "//bin/noelv_serv_boot:memh"
