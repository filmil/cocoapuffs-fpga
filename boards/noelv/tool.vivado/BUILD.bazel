    xelab_relaxed = True,
    tags = ["manual"],
)

# ZIRCON rung-3 boot sim WITHOUT OpenSBI: the //bin/noelv_zircon_handoff stub
# jumps straight into the riscv64-boot-shim at 0x240000 (inside the zircon
# lowram image) with a1 = the embedded ZBI-aware DTB (fw_fdt_bin @0x5c000,
# chosen/linux,initrd -> the ZBI bank at 0x10000000).  Sidesteps the xsim
# post-banner fdt wedge AND the ~18 ms OpenSBI boot (2026-07-02 run), so the
# whole budget goes to shim + physboot.  Watch AHBMON for: DTB reads @0x5cxxx,
# ZBI reads @0x10xxxxxx, kernel placement writes; a stub-latched fault spins
# (rerun short with disas=1 to read s0/s1/s2 = mcause/mepc/mtval).
vivado_simulation(
    name = "zircon_zbi_handoff_trace",
    data = [
        "//bin/noelv_zircon_handoff:memh",
        "//boards/noelv:opensbi_fw_zircon_sim_lowram_mem",
        _KERNEL_ZBI_MEM,
    ],
    extra_modules = ["glbl.glbl"],
    generic_tops = {
        # 150 ms: the 20 ms probe caught the shim RELOCATING the ZBI from
        # 0x10000000 to low RAM at dest = src-offset + 0x102010, ~15 KB/ms sim
        # (~230 KB of 1.85 MB done at cutoff, container trailer validated, no
        # fault).  150 ms sees the copy cross the shim's own 0x240000 region
        # (~90 ms -- self-overwrite hazard unless the shim self-relocated, the
        # early 0x27Exxx writes suggest it did), the full copy (~125 ms), and
        # the physboot jump.  Uses the SIM firmware (board_zircon_sim_dtb @ the
        # same fw_fdt_bin 0x5c000, verified) = a true miniature of
        # zircon_full_boot's post-handoff phase.
        "sim_duration_ns": "150000000",
        "noelv_memfile": "$(location //bin/noelv_zircon_handoff:memh)",
        "noelv_memsize": "4096",
        "lowmem_file": "$(location //boards/noelv:opensbi_fw_zircon_sim_lowram_mem)",
        "lowmem_size": "67108864",  # 64 MiB, same window as the zbi target
        "lowmem_regbits": "26",
        "zbi_file": "$(location {})".format(_KERNEL_ZBI_MEM),
        "zbi_size": "4194304",  # 4 MiB (ZBI ~1.85 MB)
        "zbi_regbits": "22",
        "zbi_haddr": "256",  # 0x10000000
        "zbi_hmask": "4092",  # 4 MiB window
        "disas": "0",
    },
    custom_tcl_script = "sim_no_vcd.tcl",
    library = ":tb_only",
    top = "tb_noelvsys_only",
    xelab_args = [
        "-mt",
        "off",
        "-O0",
    ],
    xelab_relaxed = True,
    tags = ["manual"],
)

