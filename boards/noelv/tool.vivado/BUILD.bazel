# LR/SC reservation probe in sim (//bin/noelv_lrsctest): runs lr.d/sc.d on the
# low "DDR3" RAM (here a behavioral ahb_bram, not the real ahb2wb_bridge/DDR3).
# On hardware lrsctest reports "LRSC BAD 0/1000" -- sc.d never succeeds, which
# wedges OpenSBI's atomic_cmpxchg at the S-mode handoff.  This localizes the bug:
#   - if sc.d ALSO fails here -> the core's reservation logic (caches disabled)
#     is at fault, reproducible offline (then test enabling the D-cache in sim);
#   - if sc.d SUCCEEDS here -> reservations are fine and the DDR3/bridge path
#     (no exclusive monitor) is at fault, like the byte-strobe bug.
# disas=1 prints W[...] register writes: after each sc.d, t3 = 0 (success) or 1
# (failure) -- lands in the first ~10 us, so a short run answers the question.
# Low RAM must decode 0x80000 (the lr/sc target): regbits=20 = 1 MiB.
vivado_simulation(
    name = "lrsctest_sim",
    data = ["//bin/noelv_lrsctest:memh"],
    extra_modules = ["glbl.glbl"],
    generic_tops = {
        "sim_duration_ns": "200000",  # 200 us; the sc.d result lands in ~10 us
        "noelv_memfile": "$(location //bin/noelv_lrsctest:memh)",
        "noelv_memsize": "4096",
        "lowmem_size": "1048576",
        "lowmem_regbits": "20",
        "disas": "1",
    },
    library = ":tb_only",
    top = "tb_noelvsys_only",
    xelab_args = [
        "-mt",
        "off",
        "-O0",
    ],
    xelab_relaxed = True,
    tags = ["manual"],
)

